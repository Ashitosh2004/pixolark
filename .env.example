# Pixolark environment variables.
# Copy this file to .env and fill in your values.
#
# This is the COMPLETE list — Pixolark reads no other environment variables.
# Note: VITE_* variables are baked into the client bundle at build time,
# so anything here is public by definition — only put client-safe values below.

# --- Coordinator (optional) -------------------------------------------------
# WebSocket endpoint of the coordination server (see server/src/index.ts).
# Default when unset: same-origin `ws(s)://<host>/coordinator`
# (src/components/pixel/PixelApp.tsx:94) — the right value whenever a reverse
# proxy upgrades /coordinator on the site's own origin.
# The vite dev server does NOT proxy /coordinator, so local development against
# `bun server/src/index.ts` needs the line below uncommented:
# VITE_COORDINATOR_URL=ws://localhost:8787/coordinator
# (start.bat sets this for the dev window when .env leaves it unset.
#  For a same-origin deployment, DELETE the line — do not leave it empty:
#  an empty string is not the same as unset.)

# --- GIF search tab (optional) ----------------------------------------------
# Enables the optional GIF search tab. Free key:
# https://developers.giphy.com/dashboard/
# Read by src/lib/pixel/env.ts; empty = tab has no key.
VITE_GIPHY_API_KEY=

# --- Signed static room directory (optional) --------------------------------
# Comma-separated mirror base URLs for the signed room-directory JSON tree
# (src/lib/pixel/directory.ts). Default when unset: /room-directory — i.e. the
# copy served by the app itself. The dev copy is gitignored at
# public/room-directory/; generate it with
#   bun tools/directory-publisher/build.ts --out public/room-directory
# Publishing to real static hosts: tools/directory-publisher/README.md.
# VITE_DIRECTORY_URL=https://dir1.example/room-directory,https://dir2.example/room-directory

# --- Coordinator port (optional) --------------------------------------------
# Port the coordination server listens on (server/src/index.ts:26).
# Default when unset: 8787. Read ONLY by the coordinator process — the
# built-in Nitro app server in docs/DEPLOYMENT.md honours PORT separately
# (default 3000).
# PORT=8787

# --- Coordinator origin allowlist (optional, recommended in production) ------
# Comma-separated list of WS Origins allowed to open /coordinator (read by
# server/src/index.ts at each start). UNSET = public coordinator: any site may
# connect, matching the beacon/ntfy semantics. Set it on your hosting provider
# to only serve your own frontend, e.g.:
# ALLOWED_ORIGINS=https://pixolark.vercel.app
# Browsers always send Origin on WebSocket connects; non-matching (or missing)
# origins get a 403 handshake rejection.

# --- Coordinator resource caps (optional tuning; test hooks) -----------------
# Defaults are generous for humans and hostile to abuse. The COORD_* names are
# also used by src/test/coordinator-hardening.test.ts to exercise the caps.
# COORD_MAX_CONNECTIONS=512      # concurrent WS connections (extra → close 1013)
# COORD_MAX_CONNS_PER_IP=8       # concurrent WS connections per client IP
# COORD_MAX_ROOMS=256            # total rooms in the registry
# COORD_MAX_ROOMS_PER_CONN=8     # rooms one connection may hold
# COORD_MAX_MEMBERS=64           # live members per room
# COORD_PING_MS=30000            # heartbeat interval; silent sockets are reaped
